{
  "name": "job-radar-dk",
  "version": "0.1.0",
  "private": true,
  "description": "Watches Danish tech companies' career pages, scores new jobs with an LLM, and emails strong matches.",
  "packageManager": "pnpm@12.18.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "pipeline:run": "pnpm --filter @jobradar/pipeline start",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "db:validate": "pnpm --filter @jobradar/db validate",
    "db:migrate": "pnpm --filter @jobradar/db migrate",
    "db:studio": "pnpm --filter @jobradar/db studio",
    "db:sync": "pnpm --filter @jobradar/db sync",
    "email:test": "pnpm --filter @jobradar/pipeline email:test",
    "db:deploy": "pnpm --filter @jobradar/db migrate:deploy"
  }
}
